import yaml

configfile: "config.yaml"

with open("data/test_cases.yaml") as f:
    TEST_CASES = yaml.safe_load(f) or []

CASES = [tc["name"] for tc in TEST_CASES]
PERMISSION_MODES = {tc["name"]: tc.get("permission_mode") for tc in TEST_CASES}

# "default" = no --size passed at all, whatever the vendor's own default
# resolves to (sonnet, confirmed by testing - see agent-runner_design.md).
# The rest are agent-runner's vendor-agnostic size alias. Each case opts
# into the sizes worth its cost via "sizes:" in test_cases.yaml (default:
# just "default") - most cases don't need a 4-way comparison.
CASE_SIZE_PAIRS = [(tc["name"], size) for tc in TEST_CASES for size in tc.get("sizes", ["default"])]

include: "rules/split_test_cases.smk"
include: "rules/run_subject.smk"
include: "rules/judge_result.smk"
include: "rules/collect_results.smk"
